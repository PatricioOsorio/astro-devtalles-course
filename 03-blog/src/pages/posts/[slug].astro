---
import type { GetStaticPaths } from 'astro';

import { getCollection } from 'astro:content';
import BlogLayout from '@layouts/BlogLayout.astro';
import { Formatter } from '@utils/formatter';

export const getStaticPaths = (async () => {
  const posts = await getCollection('posts');

  const paths = posts.map((post) => ({
    params: {
      slug: post.slug,
    },
    props: {
      post: post,
    },
  }));
  return paths;
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { data } = post;
const { title, date, description, author, image, tags } = data;

const { Content, headings } = await post.render();
---

<BlogLayout title={title}>
  <header class="relative h-[40vh] min-h-[300px] w-full overflow-hidden rounded-3xl mb-8 fade-up">
    <img
      src={image}
      alt={title}
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 hover:scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-base-100 via-base-100/10 to-transparent">
    </div>

    <div class="absolute bottom-0 left-0 p-8 w-full">
      <div class="flex flex-wrap gap-2 mb-4">
        {tags.map((tag) => <span class="badge-tech uppercase tracking-wider">{tag}</span>)}
      </div>
      <h1
        class="text-4xl md:text-5xl lg:text-6xl font-black text-white leading-tight mb-2 drop-shadow-lg"
      >
        {title}
      </h1>
      <div class="flex items-center gap-4 text-sm md:text-base text-gray-300">
        <span class="flex items-center gap-1">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"
            ></circle></svg
          >
          {author}
        </span>
        <span class="flex items-center gap-1">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line
              x1="16"
              y1="2"
              x2="16"
              y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line
              x1="3"
              y1="10"
              x2="21"
              y2="10"></line></svg
          >
          {Formatter.formatDate(date)}
        </span>
      </div>
    </div>
  </header>

  <section class="max-w-4xl mx-auto mb-12">
    <div class="card-glass p-8 md:p-12 fade-up" style="animation-delay: 0.1s">
      <div class="mb-10 p-6 rounded-2xl bg-white/5 border border-white/5">
        <div class="flex items-center gap-2 mb-6 text-primary">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"
            ></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"
            ></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line
              x1="3"
              y1="18"
              x2="3.01"
              y2="18"></line></svg
          >
          <h2 class="text-xs font-black uppercase tracking-[0.2em] m-0">En este artículo</h2>
        </div>

        {
          headings.length > 0 && (
            <nav>
              <ul class="space-y-4">
                {headings.map((heading) => (
                  <li
                    class={`transition-all duration-300 hover:translate-x-1 ${heading.depth > 2 ? 'ml-6 border-l border-white/10 pl-4' : ''}`}
                  >
                    <a
                      href={`#${heading.slug}`}
                      class="group flex items-center gap-3 text-gray-400 hover:text-white transition-colors no-underline"
                    >
                      <span class="w-1.5 h-1.5 rounded-full bg-primary/30 group-hover:bg-primary transition-all duration-300" />
                      <span class="text-sm md:text-base font-medium leading-tight">
                        {heading.text}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </div>

      <div class="prose-tech prose-lg max-w-none">
        <p class="text-xl text-gray-100 leading-relaxed italic mb-8 border-l-4 border-primary pl-6">
          {description}
        </p>

        <Content />
      </div>

      <div class="mt-12 pt-8 border-t border-white/10 flex justify-between items-center">
        <div class="flex gap-4">
          <button class="btn-ghost-tech btn-sm pulse-glow px-4">Share</button>
          <button class="btn-ghost-tech btn-sm px-4">Save</button>
        </div>
        <a href="/" class="btn-primary-tech btn-sm px-6"> Back to Blog </a>
      </div>
    </div>
  </section>
</BlogLayout>
