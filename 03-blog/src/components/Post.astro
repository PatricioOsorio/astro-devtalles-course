---
import type { IPostUI } from '@interfaces/post-ui.interface';
import '@styles/components/post-card.css';

interface Props extends IPostUI {}

const {
  title,
  excerpt,
  href,
  category,
  image,
  imageAlt,
  publishedAt,
  publishedAtISO,
  readingTime,
} = Astro.props as Props;
---

<article class="post-card">
  <figure class="post-card__media">
    <img class="post-card__image" src={image} alt={imageAlt} loading="lazy" decoding="async" />
  </figure>

  <div class="post-card__body">
    <div class="post-card__meta-row">
      <span class="post-card__category">{category}</span>
      <span class="post-card__reading-time">{readingTime}</span>
    </div>

    <div class="post-card__content">
      <h2 class="post-card__title">
        <a href={href} class="post-card__title-link">
          {title}
        </a>
      </h2>
      <p class="post-card__excerpt">{excerpt}</p>
    </div>

    <div class="post-card__footer">
      <time class="post-card__date" datetime={publishedAtISO}>{publishedAt}</time>
      <a href={href} class="post-card__cta">Read article</a>
    </div>
  </div>
</article>
